# WebSocket server that receives the audio tracks from the recording browser
WS_HOST=127.0.0.1
WS_PORT=8765
# Inside Docker the working dir is /app, so ./tmp is /app/tmp (mounted to ./tmp on the host).
SAVE_DIR=./tmp
# "whisper" when using docker-compose-whisper.yaml; "host.docker.internal" for a whisper server on the host.
WHISPER_HOST=127.0.0.1
WHISPER_PORT=8080
# whisper.cpp release built by docker/Dockerfile.whisper
WHISPER_VERSION=1.8.4
# Spoken language, sent with every transcription request
WHISPER_LANGUAGE=pt
# Beam search width for whisper (1 = greedy, faster on CPU, more swapped words)
WHISPER_BEAM_SIZE=5
# CPU threads of the whisper server (whisper.cpp uses 4 by default); read when the container is created
WHISPER_THREADS=12

# Optional
# Save periodic screenshots of the Teams pre-join screen to the session folder
RECORDING_DEBUG=false
# Stop recording after this many seconds if the end of the meeting is not detected
MAX_RECORDING_SECONDS=7200
# Files the recorder injects or starts; the defaults are the ones in gravai/recording/
#RTC_INTERCEPT_JS_PATH=
#VAD_OBSERVER_TEAMS_JS_PATH=
#AUDIO_WORKLET_JS_PATH=
#WS_AUDIO_SERVER_PATH=
# Timezone used for the date/time the API writes in the header of recorded meetings (the container runs in UTC).
TIMEZONE=America/Fortaleza
# Secret the SGL sends in the X-API-Key header. Set it on any server reachable by others: without it anyone on the
# network can send the bot to a meeting. Empty: no key asked. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Minutes generation. "openai_compatible" calls an online API in the OpenAI format (Groq, OpenRouter, DeepInfra, OpenAI...);
# "ollama" runs locally; "groq" is the legacy path via GROQ_* below;
# "fake" fills every section with placeholder text (no LLM) so the API and the demo run anywhere.
LLM_PROVIDER=openai_compatible
# Online provider (LLM_PROVIDER=openai_compatible). Same three variables for every provider, only the URL and key change:
#   Groq:       https://api.groq.com/openai/v1         model ex.: openai/gpt-oss-120b (list: GET {LLM_BASE_URL}/models)
#   OpenRouter: https://openrouter.ai/api/v1           model ex.: liquid/lfm-2.5-2.6b:free (":free" = free tier)
#   DeepInfra:  https://api.deepinfra.com/v1/openai    model ex.: meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# gpt-oss-120b: the only model with 5/5 minutes on the Groq free tier (experiments/README.md). qwen/qwen3.8-27b writes better
# minutes but hits the free tier output limit on long meetings.
LLM_MODEL=openai/gpt-oss-120b
# Reply cap for the online provider (reasoning tokens count against it on gpt-oss models)
LLM_MAX_TOKENS=8000
# "http://host.docker.internal:11434" when the API runs in Docker and Ollama on the host.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Context window asked from Ollama; must hold the prompt plus one transcript part
OLLAMA_NUM_CTX=16384
# Give up on a single LLM request after this many seconds
LLM_TIMEOUT_SECONDS=600
# Where the minutes jobs are stored (default: <SAVE_DIR>/minutes_jobs.sqlite3)
#JOBS_DB_PATH=

# Optional: keys per provider for experiments/run_experiments.py (see PROVIDERS there)
#GROQ=
#OPEN_ROUTER=
#OPENAI_API_KEY=

# Optional: only needed for POST /analyze_transcript (debate analysis via Groq)
GROQ_API_KEY_ENV=
GROQ_MODEL=
MAX_RETRIES=3
MAX_TOKENS=8000
BASE_BACKOFF_SECONDS=2
CHUNK_SIZE=40
DAILY_TOKEN_BUDGET=500000
RESERVED_FOR_AGGREGATION=20000
